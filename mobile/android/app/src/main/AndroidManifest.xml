<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Engines' HTTP and WebSockets go out from native code, checked by NetPolicy. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifications (asked at run time on Android 13+), and the foreground service that keeps services connected. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Camera and microphone, for calls: in web-client modules' own pages (WebClientPolicy, the desktop's
         permission allowlist), and in a chat view only for its own call in progress (CallPolicy); asked when
         a page asks. Neither is required. Calls set the audio mode and route (CallAudio), Bluetooth headsets
         through SCO before Android 12, and turn the screen off at the ear (a proximity wake lock). While in a
         call the background service also holds the microphone, and the camera with video. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- "Start with your phone" (off by default): BootReceiver starts ConnectionService after a reboot or an update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MulticordApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="Multicord"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="false">

        <!-- The screen only: engines, views and the shell page live in the Hub, beyond the activity. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the services' connections (native WebSockets and the engines that read them) running in the
             background, as Element's and Conversations' F-Droid builds do. specialUse: none of the defined types fits.
             dataSync is capped at 6 hours a day from Android 15, and remoteMessaging is for handing messages
             between a user's devices; this keeps the user's own chat connections open so messages and calls
             arrive, for services without push that needs no Google services (mobile/android/README.md).
             microphone and camera: only while the user is in a call, with its runtime permission (CallPolicy). -->
        <service
            android:name=".background.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone|camera">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's chat services connected (WebSocket and sync connections to their own servers) so incoming messages and calls are delivered; these services offer no push without Google Play Services." />
        </service>

        <!-- After a reboot or an update of Multicord, starts the background service if the user turned on
             "Start with your phone"; both are protected broadcasts only the system sends. -->
        <receiver
            android:name=".background.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Single sign-on comes back here from the browser: <applicationId>.sso:/<one-time path>?loginToken=...
             Any app could register the same scheme; SsoBroker accepts only its one waiting request's path. -->
        <activity
            android:name=".sso.SsoRedirectActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.sso" />
            </intent-filter>
        </activity>
    </application>
</manifest>
