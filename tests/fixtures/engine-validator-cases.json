    "MAX_KEY": 200,
    "MAX_TEXT": 200,
    "MAX_BODY_TEXT": 2000,
    "MAX_SERVERS": 1000,
    "MAX_DIRECTS": 500,
    "MAX_DATA_IMAGE": 200000,
    "MAX_SECRET": 16384,
    "MAX_HTTP_BODY": 52428800,
