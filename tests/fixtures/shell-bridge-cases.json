      { "type": "theme", "theme": "dark" },
      { "type": "notify", "instance": "matrix", "title": "", "body": "", "target": "t" },
      { "type": "notify", "instance": "matrix", "title": { "$repeat": "t", "times": "MAX_TEXT" }, "body": { "$repeat": "b", "times": "MAX_BODY_TEXT" }, "target": { "$repeat": "k", "times": "MAX_KEY" }, "railKey": "dm:t", "urgent": true },
      { "type": "badge", "count": 0 },
