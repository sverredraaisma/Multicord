{
  "about": "Cases for the phone's shell bridge (src/mobile/protocol.ts): isShellCommand, which native code runs on what the shell page sends (mobile/android ShellCommands.kt, ShellCommandsTest), and isNativeEvent, which the page runs on what native code sends (tests/mobile/protocol.test.ts runs both). Values are JSON with the expansions of engine-validator-cases.json: {\"$repeat\": s, \"times\": n}, {\"$object\": [key, value], \"times\": n} and {\"$limit\": n}, the count n as a number; n is a number or a limit's name from limits, optionally +1 or -1.",
  "limits": {
    "MAX_FILE": 1048576,
    "MAX_COPY": 65536,
    "MAX_NAME": 64,
    "MAX_URL": 2048,
    "MAX_BADGE": 1000000,
    "MAX_EXIT": 200,
    "MAX_TEXT": 200,
    "MAX_BODY_TEXT": 2000,
    "MAX_KEY": 200
  },
  "isShellCommand": {
    "valid": [
      { "type": "save", "file": "settings", "text": "{}" },
      { "type": "save", "file": "platforms", "text": "" },
      { "type": "save", "file": "order", "text": { "$repeat": "a", "times": "MAX_FILE" } },
      { "type": "start", "instance": "matrix", "module": "matrix-native", "name": "Matrix", "url": "https://matrix.org" },
      { "type": "start", "instance": "a", "module": "fluxer", "name": { "$repeat": "n", "times": "MAX_NAME" }, "url": "https://fluxer.app/x?y=1", "settings": { "typing": true, "mode": "fast" } },
      { "type": "command", "instance": "telegram", "command": { "type": "openHome" } },
      { "type": "command", "instance": "telegram", "command": { "type": "settings", "values": { "readReceipts": false } } },
      { "type": "layout", "instance": null, "overlay": false },
      { "type": "layout", "instance": "matrix-2", "overlay": true },
      { "type": "viewSettings", "instance": "matrix", "mediaAutoLoad": 0 },
      { "type": "viewSettings", "instance": "matrix", "mediaAutoLoad": 5242880 },
      { "type": "viewSettings", "instance": "matrix", "mediaAutoLoad": null },
      { "type": "notify", "instance": "matrix", "title": "", "body": "", "target": "t" },
      { "type": "notify", "instance": "matrix", "title": { "$repeat": "t", "times": "MAX_TEXT" }, "body": { "$repeat": "b", "times": "MAX_BODY_TEXT" }, "target": { "$repeat": "k", "times": "MAX_KEY" }, "railKey": "dm:t", "urgent": true },
      { "type": "badge", "count": 0 },
      { "type": "badge", "count": { "$limit": "MAX_BADGE" } },
      { "type": "clearSession", "instance": "matrix" },
      { "type": "forgetSecrets", "instance": "matrix" },
      { "type": "restartEngine", "instance": "tg-2" },
      { "type": "restart" },
      { "type": "backUnhandled" },
      { "type": "copyText", "text": "report" },
      { "type": "copyText", "text": { "$repeat": "r", "times": "MAX_COPY" } }
    ],
    "invalid": [
      null,
      [],
      "restart",
      {},
      { "type": "nope" },
      { "type": "restart", "extra": 1 },
      { "type": "save", "file": "credentials", "text": "{}" },
      { "type": "save", "file": "settings" },
      { "type": "save", "file": "settings", "text": 5 },
      { "type": "save", "file": "settings", "text": { "$repeat": "a", "times": "MAX_FILE+1" } },
      { "type": "start", "instance": "Matrix", "module": "matrix-native", "name": "M", "url": "https://matrix.org" },
      { "type": "start", "instance": "-a", "module": "matrix-native", "name": "M", "url": "https://matrix.org" },
      { "type": "start", "instance": { "$repeat": "a", "times": 33 }, "module": "matrix-native", "name": "M", "url": "https://matrix.org" },
      { "type": "start", "instance": "a", "module": "../x", "name": "M", "url": "https://matrix.org" },
      { "type": "start", "instance": "a", "module": "fluxer", "name": "", "url": "https://matrix.org" },
      { "type": "start", "instance": "a", "module": "fluxer", "name": { "$repeat": "n", "times": "MAX_NAME+1" }, "url": "https://matrix.org" },
      { "type": "start", "instance": "a", "module": "fluxer", "name": "M", "url": "http://matrix.org" },
      { "type": "start", "instance": "a", "module": "fluxer", "name": "M", "url": "not a url" },
      { "type": "start", "instance": "a", "module": "fluxer", "name": "M", "url": "https://matrix.org", "settings": { "a": 1 } },
      { "type": "start", "instance": "a", "module": "fluxer", "name": "M", "url": "https://matrix.org", "hosts": ["*"] },
      { "type": "start", "instance": "a", "module": "fluxer", "name": "M", "url": "https://matrix.org", "engine": "telegram" },
      { "type": "command", "instance": "a", "command": { "type": "nope" } },
      { "type": "command", "command": { "type": "openHome" } },
      { "type": "layout", "instance": "A", "overlay": false },
      { "type": "layout", "overlay": false },
      { "type": "layout", "instance": null, "overlay": "yes" },
      { "type": "viewSettings", "instance": "a", "mediaAutoLoad": -1 },
      { "type": "viewSettings", "instance": "a", "mediaAutoLoad": 1.5 },
      { "type": "viewSettings", "instance": "a" },
      { "type": "notify", "instance": "a", "title": "t", "body": "b" },
      { "type": "notify", "instance": "a", "title": "t", "body": "b", "target": "" },
      { "type": "notify", "instance": "a", "title": { "$repeat": "t", "times": "MAX_TEXT+1" }, "body": "b", "target": "t" },
      { "type": "notify", "instance": "a", "title": "t", "body": { "$repeat": "b", "times": "MAX_BODY_TEXT+1" }, "target": "t" },
      { "type": "notify", "instance": "a", "title": "t", "body": "b", "target": "t", "railKey": "" },
      { "type": "notify", "instance": "a", "title": "t", "body": "b", "target": "t", "urgent": "yes" },
      { "type": "notify", "instance": "a", "title": "t", "body": "b", "target": "t", "icon": "https://x.test/i.png" },
      { "type": "badge", "count": -1 },
      { "type": "badge", "count": { "$limit": "MAX_BADGE+1" } },
      { "type": "badge", "count": 1.5 },
      { "type": "badge" },
      { "type": "clearSession", "instance": "" },
      { "type": "forgetSecrets" },
      { "type": "restartEngine", "instance": "matrix", "extra": 1 },
      { "type": "restartEngine", "instance": "../x" },
      { "type": "copyText", "text": { "$repeat": "r", "times": "MAX_COPY+1" } },
      { "type": "copyText" }
    ]
  },
  "isNativeEvent": {
    "valid": [
      { "type": "engine", "instance": "matrix", "event": { "type": "homeBadge", "badge": { "unread": true, "mentions": 2 } } },
      { "type": "health", "instance": "matrix", "state": "running", "restarts": 0 },
      { "type": "health", "instance": "matrix", "state": "stopped", "restarts": 6, "lastExit": "crashed" },
      { "type": "health", "instance": "matrix", "state": "starting", "restarts": 1, "lastExit": { "$repeat": "x", "times": "MAX_EXIT" } },
      { "type": "appVisible", "visible": false },
      { "type": "back" },
      { "type": "openNotification", "instance": "matrix", "target": "!room:x.org" },
      { "type": "openNotification", "instance": "matrix", "target": "t", "railKey": "dm:t" }
    ],
    "invalid": [
      null,
      { "type": "nope" },
      { "type": "engine", "instance": "matrix", "event": { "type": "nope" } },
      { "type": "engine", "instance": "Matrix", "event": { "type": "homeBadge", "badge": { "unread": true, "mentions": 2 } } },
      { "type": "health", "instance": "matrix", "state": "gone", "restarts": 0 },
      { "type": "health", "instance": "matrix", "state": "running", "restarts": -1 },
      { "type": "health", "instance": "matrix", "state": "running", "restarts": 0, "lastExit": { "$repeat": "x", "times": "MAX_EXIT+1" } },
      { "type": "appVisible", "visible": "yes" },
      { "type": "openNotification", "instance": "matrix", "target": "" },
      { "type": "openNotification", "instance": "matrix", "target": "t", "railKey": 5 }
    ]
  }
}
