      { "type": "discordNotificationClick", "instance": "dc", "id": 4 },
      { "type": "discordNotificationClick", "instance": "dc", "id": "" },
      { "type": "discordNotificationClick", "instance": "dc", "id": "4", "extra": 1 }
    ]
  },
