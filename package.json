{
  "name": "multicord",
  "version": "0.1.0",
  "private": true,
  "description": "Unified chat client: Discord's web client plus alternative platforms behind one server rail",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run coverage",
    "gallery": "npm run build && node scripts/open-gallery.mjs",
    "smoke": "node scripts/smoke.mjs",
    "a11y": "node scripts/a11y.mjs",
    "live:media": "node scripts/live-media/run.mjs",
    "dist": "npm run build && electron-builder",
    "dist:flatpak": "node scripts/flatpak.mjs",
    "icons": "electron scripts/icons.cjs"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.9.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "altcha-lib": "^2.8.0",
    "axe-core": "4.14.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.18.0",
    "emojibase-data": "^18.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "livekit-client": "^2.23.0",
    "matrix-js-sdk": "^44.0.0",
    "telegram": "^2.26.22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "app.multicord.desktop",
    "productName": "Multicord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "LICENSE",
      "NOTICE.md",
      "!dist/**/*.map",
      "!dist/gallery.*",
      "!dist/mobile/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "sverredraaisma",
        "repo": "Multicord"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Multicord-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Multicord shares your system audio when you share your screen.",
        "NSMicrophoneUsageDescription": "Multicord uses your microphone for calls.",
        "NSCameraUsageDescription": "Multicord uses your camera for video calls."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network;Chat"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "optionalDependencies": {
    "@vencord/venmic": "7.2.3"
  },
  "overrides": {
    "@vencord/venmic": {
      "cmake-js": "^8.0.0"
    }
  }
}
